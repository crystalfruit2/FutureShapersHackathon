[sub_resource type="Shader" id="Shader_stars"]
code = "shader_type canvas_item;
// render.py redraws its starfield every frame, so sky.png has no stars at all -
// the port lost them.  Generated here instead: procedural, per-star twinkle,
// and it rides the parallax layer for free.
uniform float density : hint_range(0.0, 0.05) = 0.008;
uniform float twinkle : hint_range(0.0, 1.0) = 1.0;
uniform vec3 star_dim : source_color = vec3(0.776, 0.824, 0.941);
uniform vec3 star_hot : source_color = vec3(1.0, 0.988, 0.91);
float h(vec2 p) { return fract(sin(dot(p, vec2(41.7, 289.3))) * 43758.5453); }
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	vec2 cell = floor(UV * vec2(640.0, 102.0));
	// thin out towards the horizon, where the sky washes out anyway
	float fade = 1.0 - smoothstep(0.45, 1.0, UV.y);
	if (h(cell) > 1.0 - density * fade) {
		float ph = h(cell + vec2(7.3, 1.9));
		float tw = 0.55 + 0.45 * sin(TIME * 1.7 + ph * 56.5);
		vec3 sc = tw > 0.86 ? star_hot : star_dim;
		c.rgb = mix(c.rgb, sc, mix(1.0, tw, twinkle) * c.a);
	}
	COLOR = c;
}
"

[sub_resource type="ShaderMaterial" id="Mat_stars"]
shader = SubResource("Shader_stars")
shader_parameter/density = 0.008
shader_parameter/twinkle = 1.0
shader_parameter/star_dim = Color(0.776, 0.824, 0.941, 1)
shader_parameter/star_hot = Color(1, 0.988, 0.91, 1)

[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;
// quantised so it bands like the rest of the art instead of smearing.
uniform float strength : hint_range(0.0, 1.0) = 0.34;
void fragment() {
	float d = length(UV - vec2(0.5));
	float v = smoothstep(0.34, 0.9, d);
	COLOR = vec4(0.02, 0.01, 0.05, v * strength);
}
"

[sub_resource type="ShaderMaterial" id="Mat_vignette"]
shader = SubResource("Shader_vignette")
shader_parameter/strength = 0.34

[sub_resource type="Shader" id="Shader_crt"]
code = "shader_type canvas_item;
// makes the dashboard beat read as a screen, not a slide.
uniform float scan : hint_range(0.0, 0.5) = 0.14;
uniform float sweep : hint_range(0.0, 0.5) = 0.05;
void fragment() {
	float fade = COLOR.a;   // carries the parent Control-s modulate
	float line = mod(FRAGCOORD.y, 3.0) < 1.0 ? scan : 0.0;
	float band = smoothstep(0.0, 0.06, abs(fract(UV.y - TIME * 0.12) - 0.5) - 0.44);
	vec4 c = vec4(0.0, 0.0, 0.0, line) + vec4(0.55, 0.85, 1.0, band * sweep);
	c.a *= fade;
	COLOR = c;
}
"

[sub_resource type="ShaderMaterial" id="Mat_crt"]
shader = SubResource("Shader_crt")
shader_parameter/scan = 0.14
shader_parameter/sweep = 0.05

